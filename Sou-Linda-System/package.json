{
  "name": "sou-linda-system",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "python server/run.py",
    "test": "vitest run",
    "test:server": "cd server && .venv/bin/python -m pytest tests"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.0"
  }
}
